DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_manager?schema=public"
PORT=4311
HOST=0.0.0.0
SESSION_SECRET="replace-with-a-long-random-secret"
STORAGE_DIR="./storage"
AI_ENABLED=false
AI_API_KEY=""
# llama.cpp llama-server 默认地址（OpenAI 兼容 /v1 路径）
AI_BASE_URL="http://127.0.0.1:8080/v1"
AI_MODEL="qwen2.5-vl-7b-instruct"
# 可选：自定义识别提示词文件，默认读取 server/prompts/tagging.txt
# AI_PROMPT_FILE="D:\models\tagging-prompt.txt"
# 可选：Hugging Face 下载镜像（国内网络可填 https://hf-mirror.com）
# AI_DOWNLOAD_MIRROR="https://hf-mirror.com"
