DATABASE_URL="postgresql://postgres:postgres@localhost:5432/image_manager?schema=public"
PORT=4311
HOST=0.0.0.0
SESSION_SECRET="replace-with-a-long-random-secret"
# 会话 Cookie 是否只允许 HTTPS（默认跟随 NODE_ENV：production 时为 true）
# 纯 HTTP 的内网/Docker 部署必须设为 false，否则浏览器不会保存登录态
# COOKIE_SECURE=false
# 是否信任反向代理传来的 X-Forwarded-For。
# 经 nginx / 内网穿透（frp，如 fluxframe.example.com）访问时必须设为 true：
# 否则所有请求的来源 IP 都会记成 Docker 网关 172.19.0.1，审计日志里一律显示「内网」。
# 只有服务直接暴露、前面没有任何代理时才保持 false，避免来源 IP 被伪造。
# TRUST_PROXY=true
STORAGE_DIR="./storage"
AI_ENABLED=false
AI_API_KEY=""
# llama.cpp llama-server 默认地址（OpenAI 兼容 /v1 路径）
AI_BASE_URL="http://127.0.0.1:8080/v1"
AI_MODEL="qwen2.5-vl-7b-instruct"
# 可选：自定义识别提示词文件，默认读取 server/prompts/tagging.txt
# AI_PROMPT_FILE="D:\models\tagging-prompt.txt"
# 可选：Hugging Face 下载镜像（国内网络可填 https://hf-mirror.com）
# AI_DOWNLOAD_MIRROR="https://hf-mirror.com"
