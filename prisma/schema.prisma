generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum AuditScope {
  INTERNAL
  EXTERNAL
  UNKNOWN
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         UserRole    @default(USER)
  createdAt    DateTime    @default(now())
  sessions     Session[]
  images       Image[]     @relation("Uploader")
  audits       AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Image {
  id          String        @id @default(cuid())
  name        String
  originalKey String
  mimeType    String
  size        BigInt
  width       Int?
  height      Int?
  sha256      String        @unique
  viewCount   Int           @default(0)
  lastViewed  DateTime?
  capturedAt  DateTime?
  uploadedAt  DateTime      @default(now())
  deletedAt   DateTime?
  deletedById String?
  uploaderId  String
  uploader    User          @relation("Uploader", fields: [uploaderId], references: [id])
  variants    ImageVariant[]
  tags        ImageTag[]
  @@index([deletedAt, uploadedAt])
  @@index([viewCount])
}

model ImageVariant {
  id      String @id @default(cuid())
  imageId String
  width   Int
  key     String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  @@unique([imageId, width])
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  color     String     @default("#a78bfa")
  createdAt DateTime   @default(now())
  images    ImageTag[]
}

model ImageTag {
  imageId  String
  tagId    String
  addedById String?
  addedAt  DateTime @default(now())
  image    Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag      Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([imageId, tagId])
}

model AuditLog {
  id        String     @id @default(cuid())
  action    String
  target    String?
  userId    String?
  ip        String
  scope     AuditScope
  userAgent String?
  createdAt DateTime   @default(now())
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([userId, createdAt])
}

model UploadJob {
  id        String   @id @default(cuid())
  status    String
  fileName  String
  progress  Int      @default(0)
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
